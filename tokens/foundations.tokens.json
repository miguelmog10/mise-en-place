{
  "$description": "Shared foundations for both theme families: type scale, spacing, lines and canvas sizes. Family-specific type (fonts, body line height, label spacing) lives in tokens/themes/<family>/family.tokens.json. Two scales: web (rem, for screens and docs) and canvas (px, for fixed-size images such as the 1080 x 1350 carousel).",
  "font": {
    "family": {
      "$type": "fontFamily",
      "system": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "$description": "Where custom fonts cannot load, such as Mermaid on GitHub."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Web scale. 16px root. Body copy is 300.",
      "050": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        },
        "$description": "12px. Small uppercase labels (screen family, mono)."
      },
      "100": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        },
        "$description": "14px. Captions, labels."
      },
      "200": {
        "$value": {
          "value": 1,
          "unit": "rem"
        },
        "$description": "16px. UI text, dense docs."
      },
      "300": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        },
        "$description": "18px. Body copy."
      },
      "400": {
        "$value": {
          "value": 1.375,
          "unit": "rem"
        },
        "$description": "22px. Kickers, lead paragraphs."
      },
      "500": {
        "$value": {
          "value": 1.75,
          "unit": "rem"
        },
        "$description": "28px. Section headings."
      },
      "600": {
        "$value": {
          "value": 2.25,
          "unit": "rem"
        },
        "$description": "36px. Page headings."
      },
      "700": {
        "$value": {
          "value": 3,
          "unit": "rem"
        },
        "$description": "48px. Display headings."
      },
      "800": {
        "$value": {
          "value": 4.5,
          "unit": "rem"
        },
        "$description": "72px. Hero display heading, one per page (screen family)."
      }
    },
    "line-height": {
      "$type": "number",
      "heading": {
        "$value": 1.1
      },
      "list": {
        "$value": 1.3
      }
    },
    "letter-spacing": {
      "$type": "number",
      "$description": "In em. DTCG dimensions only allow px and rem, so these are plain numbers that the build emits as em.",
      "heading": {
        "$value": -0.012
      },
      "section": {
        "$value": 0.02
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Web spacing. Name = px / 8 x 100 at a 16px root (space.200 = 16px).",
    "050": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "100": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "150": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "200": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "300": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "400": {
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "600": {
      "$value": {
        "value": 3,
        "unit": "rem"
      }
    },
    "800": {
