      "$type": "dimension",
      "hairline": {
        "$value": {
          "value": 1,
          "unit": "px"
        },
        "$description": "Dividers on screen."
      },
      "mark": {
        "$value": {
          "value": 1.5,
          "unit": "px"
        },
        "$description": "Status marks: built and planned outlines, diagram boxes, secondary buttons."
      },
      "frame": {
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$description": "Ink rule under a masthead and above a footer, dashed ticket top edge, focus ring."
      },
      "rule": {
        "$value": {
          "value": 3,
          "unit": "px"
        },
        "$description": "Short accent rule under a headline on screen; the rail that stations hang from."
      },
      "double": {
        "$value": {
          "value": 4,
          "unit": "px"
