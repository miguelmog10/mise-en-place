{
  "$comment": "Read by scripts/setup-github.mjs. Each block is sent as is to the GitHub REST API, so field names match the API docs. Rulesets live in .github/rulesets/.",
  "owner": "miguelmog10",
  "name": "mise-en-place",
  "visibility": "public",
  "topics": ["design-system", "design-tokens", "dtcg", "mermaid", "accessibility", "css-variables"],
  "repository": {
    "description": "My personal design system: tokens, themes and usage rules for docs, diagrams, slides and carousels.",
    "homepage": "",
    "has_issues": true,
    "has_wiki": false,
    "has_projects": false,
    "has_discussions": false,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "PR_BODY",
    "allow_update_branch": true,
    "delete_branch_on_merge": true
  },
  "security": {
    "vulnerability_alerts": true,
    "automated_security_fixes": true,
    "private_vulnerability_reporting": true
  },
  "actions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  }
}
